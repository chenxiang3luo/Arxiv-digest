# Copy to either:
#   - /path/to/apps/.env   (repo root), or
#   - /path/to/apps/backend/.env
# If both exist, backend/.env wins for duplicate keys. No need to rely on shell cwd.

DATABASE_URL=sqlite:///./data/app.db
ADMIN_TOKEN=generate-a-long-random-secret

DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_OFFSET_DAYS=1

# Optional: narrow arXiv search (see https://arxiv.org/help/api/user-manual#query_details)
# Example: cat:cs.AI OR cat:cs.LG
ARXIV_QUERY_BASE=
ARXIV_MAX_FETCH=800

# Optional WeChat defaults (can also be set in the admin UI)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
